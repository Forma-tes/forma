# Copy to .env.local for local work. These two are PUBLIC by design (they ship to the browser);
# Row Level Security is what protects the data. NEVER put a service_role / secret key here.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
# Optional: canonical site URL used in auth emails
VITE_SITE_URL=https://your-domain.example
